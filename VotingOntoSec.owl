<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://enu.kz/ontologies/VotingOntoSec"
         xmlns="http://enu.kz/ontologies/VotingOntoSec#">

<owl:Ontology rdf:about="http://enu.kz/ontologies/VotingOntoSec"/>

<owl:ObjectProperty rdf:about="#affects">
  <rdfs:domain rdf:resource="#Threat"/>
  <rdfs:range rdf:resource="#Asset"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isHarmedBy">
  <rdfs:domain rdf:resource="#Asset"/>
  <rdfs:range rdf:resource="#Vulnerability"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#exploits">
  <rdfs:domain rdf:resource="#Threat"/>
  <rdfs:range rdf:resource="#Vulnerability"/>
  <owl:inverseOf rdf:resource="#exploitedBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#exploitedBy">
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="#Threat"/>
  <owl:inverseOf rdf:resource="#exploits"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mitigatedBy">
  <rdfs:domain rdf:resource="#Threat"/>
  <rdfs:range rdf:resource="#Countermeasure"/>
  <owl:inverseOf rdf:resource="#mitigates"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mitigates">
  <rdfs:domain rdf:resource="#Countermeasure"/>
  <rdfs:range rdf:resource="#Threat"/>
  <owl:inverseOf rdf:resource="#mitigatedBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#reduces">
  <rdfs:domain rdf:resource="#Countermeasure"/>
  <rdfs:range rdf:resource="#Vulnerability"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#protects">
  <rdfs:domain rdf:resource="#Countermeasure"/>
  <rdfs:range rdf:resource="#Asset"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasRisk">
  <rdfs:domain rdf:resource="#Asset"/>
  <rdfs:range rdf:resource="#Risk"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#givesRiseTo">
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="#Risk"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#threatens">
  <rdfs:domain rdf:resource="#Threat"/>
  <rdfs:range rdf:resource="#SecurityCriteria"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#supports">
  <rdfs:domain rdf:resource="#Countermeasure"/>
  <rdfs:range rdf:resource="#SecurityCriteria"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ownedBy">
  <rdfs:domain rdf:resource="#Asset"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSource">
  <rdfs:domain rdf:resource="#Threat"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requires">
  <rdfs:domain rdf:resource="#Asset"/>
  <rdfs:range rdf:resource="#SecurityCriteria"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dependsOn">
  <rdfs:domain rdf:resource="#Asset"/>
  <rdfs:range rdf:resource="#Asset"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasImpactLevel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Risk"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasLikelihood">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Risk"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasAssetCriticality">
  <rdfs:domain rdf:resource="#Asset"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasRiskScore">
  <rdfs:domain rdf:resource="#Risk"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasThreatProbability">
  <rdfs:domain rdf:resource="#Threat"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCVSS">
  <rdfs:domain rdf:resource="#Vulnerability"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDescription">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasIdentifier">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#isQuantumSafe">
  <rdfs:domain rdf:resource="#Countermeasure"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Asset">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VotingOntoSec concept: Asset</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Threat">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#affects"/>
      <owl:someValuesFrom rdf:resource="#Asset"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#exploits"/>
      <owl:someValuesFrom rdf:resource="#Vulnerability"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Threat</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VotingOntoSec concept: Threat</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Vulnerability">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#exploitedBy"/>
      <owl:someValuesFrom rdf:resource="#Threat"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vulnerability</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VotingOntoSec concept: Vulnerability</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Countermeasure">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reduces"/>
      <owl:someValuesFrom rdf:resource="#Vulnerability"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#mitigates"/>
      <owl:someValuesFrom rdf:resource="#Threat"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Countermeasure</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VotingOntoSec concept: Countermeasure</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Risk">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Risk</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VotingOntoSec concept: Risk</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SecurityCriteria">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SecurityCriteria</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VotingOntoSec concept: SecurityCriteria</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Availability">
  <rdfs:subClassOf rdf:resource="#SecurityCriteria"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Availability</rdfs:label>
